# Minimal distro - the packages added on top of the core.
#
# The core already provides a system booting to a login prompt, so this list
# only adds what makes it usable interactively.
#
# Lines starting with # and empty lines are ignored, the order is the order the
# packages were built in.

# the kernel this distro boots - see distros/core/packages.list
10.3-make-linux-kernel.tar.gz

8.7-make-bzip2.tar.gz
8.11-make-file.tar.gz
8.42-make-less.tar.gz
8.73-make-vim.tar.gz
12-make-which.tar.gz
5-make-grub.tar.gz

# sudo authenticates through PAM, whose stacks come with the PAM shadow
# and whose pam_unix module resolves the users through libnsl
17-make-libnsl.tar.gz
4-make-linux-pam.tar.gz
4-make-shadow.tar.gz

# remote access and privilege escalation
4-make-openssh.tar.gz
4-make-sudo.tar.gz

# inspecting the hardware of the machine it booted on
12-make-pciutils.tar.gz
