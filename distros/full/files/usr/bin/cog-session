#!/bin/sh
# Start the graphical session: a compositor with the browser inside it.
#
#   cog-session [url]
#
# What runs is weston, configured by /etc/xdg/weston/weston.ini, which
# autolaunches /usr/bin/cog-launch and exits when it exits. cog is not started
# from here directly - it used to be, drawing straight to KMS, and that path
# has no fullscreen support and a cursor that never appears.
#
# It has to run from a virtual console, not from ssh. DRM lets one process be
# master of a device, and that process is the one on the active VT. From a
# remote shell the device is already spoken for, and weston exits saying it
# cannot open /dev/dri/card0 - which reads like a permissions problem and is
# not one.
#
# Root, for the same reason. libseat is built with its builtin backend, which
# opens the devices directly when the caller already has the privilege to;
# there is no logind or seatd here to grant it to anyone else.
set -e

[ "$(id -u)" = 0 ] || {
    echo "cog-session: needs root - there is no seat manager here to grant" >&2
    echo "  the DRM device and the input devices to an unprivileged session." >&2
    exit 1
}
[ -e /dev/dri/card0 ] || {
    echo "cog-session: no /dev/dri/card0." >&2
    echo "  The kernel has not set up a display device. Check that the driver" >&2
    echo "  for this hardware is built in or loaded - without KMS there is" >&2
    echo "  nothing to draw on." >&2
    exit 1
}

# Wayland puts its socket here and refuses to start without it. Nothing on
# this system creates it: that is normally logind's job at login, and there is
# no logind. 0700 because the socket in it is the session, and anything able
# to open it can drive the display and read the input.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"
export XDG_RUNTIME_DIR

# Passed through to cog-launch, which weston starts.
[ -n "$1" ] && export COG_URL="$1"

exec weston --backend=drm
