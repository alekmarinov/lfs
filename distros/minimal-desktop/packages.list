# Minimal desktop distro - the minimal system plus a small X desktop.
#
# Deliberately curated: an X server without GL, one window manager and a
# scalable font family. The full distro is the one which grows with every
# package the build produces.
#
# The order of this list does not matter: build-distro.sh installs the core and
# the distro packages together, in the order build-packages.sh built them.

# --- everything the minimal distro has ---
8.7-make-bzip2.tar.gz
8.11-make-file.tar.gz
8.21-make-gmp.tar.gz
8.42-make-less.tar.gz
8.73-make-vim.tar.gz
12-make-which.tar.gz
5-make-grub.tar.gz
17-make-libnsl.tar.gz
4-make-linux-pam.tar.gz
4-make-shadow.tar.gz
4-make-openssh.tar.gz
4-make-sudo.tar.gz
12-make-pciutils.tar.gz

# --- the C++ runtime, which the X stack links against ---
8.29-make-gcc.tar.gz
8.22-make-mpfr.tar.gz
8.23-make-mpc.tar.gz

# --- font rendering ---
# expat parses the fontconfig configuration and the X resources
8.40-make-expat.tar.gz
10-make-libpng.tar.gz
10-make-graphite2.tar.gz
10-make-harfbuzz.tar.gz
10-make-freetype.tar.gz
10-make-fontconfig.tar.gz
10-make-pixman.tar.gz

# --- input stack ---
9-make-libevdev.tar.gz
9-make-mtdev.tar.gz
9-make-libinput.tar.gz

# --- Xorg build environment and libraries ---
24-make-util-macros.tar.gz
24-make-xorgproto.tar.gz
24-make-libXau.tar.gz
24-make-libXdmcp.tar.gz
24-make-xcb-proto.tar.gz
24-make-libxcb.tar.gz
24-make-xorg-libraries.tar.gz
24-make-libdrm.tar.gz
24-make-libxcvt.tar.gz
24-make-xbitmaps.tar.gz

# --- applications, cursors and fonts ---
24-make-xorg-apps.tar.gz
24-make-xcursor-themes.tar.gz
24-make-xorg-fonts.tar.gz
24-make-xkeyboard-config.tar.gz

# the Xorg server links against dbus for its configuration interface
12-make-dbus.tar.gz

# nettle is linked by the Xnest and Xvfb servers xorg-server installs
4-make-nettle.tar.gz

# --- the server, its input driver and the session ---
# OpenGL. Without these the X server has no glx or glamor and runs on a
# shadow frame buffer. mako and markupsafe are not here: they are only
# needed to compile Mesa, and this distro has no python.
24-make-mesa.tar.gz
25-make-libepoxy.tar.gz
25-make-glu.tar.gz
# glxinfo says whether GL is running on the gpu or on the cpu, which
# nothing else in the image can tell you
24-make-mesa-demos.tar.gz

# the gtk3 stack. nasm is not here: it only assembles libjpeg-turbo's SIMD
# code at build time. glib links the original pcre, not pcre2.
# libffi is what glib needs for its closures, libxml2 what shared-mime-info
# parses its database with
8.50-make-libffi.tar.gz
9-make-libxml2.tar.gz
9-make-pcre.tar.gz
9-make-glib.tar.gz
10-make-fribidi.tar.gz
11-make-shared-mime-info.tar.gz
10-make-libjpeg-turbo.tar.gz
10-make-libtiff.tar.gz
25-make-gdk-pixbuf.tar.gz
25-make-atk.tar.gz
25-make-at-spi2-core.tar.gz
25-make-at-spi2-atk.tar.gz
25-make-cairo.tar.gz
25-make-pango.tar.gz
25-make-gtk3.tar.gz

# firefox needs these at run time. icu was previously left out and its
# absence accepted in check.ignore - firefox linking libicuuc makes that
# no longer a choice.
9-make-icu.tar.gz
9-make-nspr.tar.gz
4-make-nss.tar.gz
22-make-sqlite.tar.gz
42-make-alsa-lib.tar.gz
# the browser
9-make-dbus-glib.tar.gz
40-make-firefox.tar.gz
24-make-xorg-server.tar.gz
24-make-xf86-input-libinput.tar.gz
24-make-xinit.tar.gz
24-make-twm.tar.gz
24-make-xclock.tar.gz
24-make-xterm.tar.gz

# a scalable font family for Xft, and a window manager with decorations,
# a menu, a toolbar and workspaces
24-make-dejavu-fonts.tar.gz
27-make-fluxbox.tar.gz

# wireless
17-make-libnl.tar.gz
15-make-iw.tar.gz
x-make-wireless-regdb.tar.gz
x-make-linux-firmware-iwlwifi.tar.gz
x-make-linux-firmware-realtek.tar.gz
15-make-wpa-supplicant.tar.gz
