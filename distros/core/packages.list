# The stable core every distro is built around.
#
# It is always installed by build-distro.sh, before the packages of the
# selected distro package list. It contains what an LFS system needs to boot
# to a login prompt and nothing else - the runtime libraries the bootscripts
# link against, the programs they call, the system configuration and the
# kernel.
#
# Lines starting with # and empty lines are ignored.

# directory layout, /etc/passwd, /etc/group
7.5-create-directories.tar.gz
7.6-create-essentials.tar.gz

# C library and the libraries the core programs link against
